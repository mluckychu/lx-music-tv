{
  "name": "lx-music-tv",
  "version": "0.1.0",
  "private": true,
  "description": "洛雪音乐 TV 版 (Android TV) — 基于 react-native-tvos 的大屏遥控音乐客户端",
  "scripts": {
    "android": "react-native run-android",
    "android-tv": "react-native run-android --variant=debug",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/*.test.ts",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "pako": "^2.1.0",
    "react": "18.2.0",
    "react-native": "npm:react-native-tvos@0.73.0-0",
    "react-native-buffer": "^6.0.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.73.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.45",
    "babel-plugin-module-resolver": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "license": "Apache-2.0"
}
